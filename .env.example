# @author gyustar
# @date 2026-09-03
# .env.example — 이 파일을 .env로 복사한 뒤 실제 값을 채워 넣는다.
# kubectl get secret -n data 로 비밀번호 확인 가능.

# App
PORT=3000
NODE_ENV=production

# PostgreSQL — CloudNativePG rw endpoint
PG_HOST=ticketing-postgresql-rw.data.svc.cluster.local
PG_PORT=5432
PG_DATABASE=ticketing
PG_USER=ticketing
PG_PASSWORD=<kubectl get secret ticketing-postgresql-app -n data>

# Redis — Sentinel HA
REDIS_SENTINELS=redis-sentinel.data.svc.cluster.local:26379
REDIS_SENTINEL_MASTER=ticketing-master
REDIS_PASSWORD=<kubectl get secret redis-auth -n data>

# Kafka — Strimzi bootstrap
KAFKA_BROKERS=ticketing-kafka-kafka-bootstrap.data.svc.cluster.local:9092
KAFKA_CLIENT_ID=app-namespace
KAFKA_CONSUMER_GROUP=app-namespace-consumers

# JWT
JWT_SECRET=<팀에서 정한 값>

# TTL
IDEMPOTENCY_TTL_SECONDS=86400
SEAT_HOLD_TTL_SECONDS=300

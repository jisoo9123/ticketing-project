# 서버
PORT=3000

# Redis (data namespace — 대기열·토큰·좌석 Hold)
REDIS_URL=redis://10.1.93.110:6379

# PostgreSQL (data namespace — 예약 확정 원본 데이터)
PGHOST=10.1.93.111
PGPORT=5432
PGDATABASE=ticketing
PGUSER=ticketing_app
PGPASSWORD=changeme

# Kafka (data namespace — booking.created / payment.requested / payment.completed / notification.requested)
KAFKA_BROKERS=10.1.93.112:9092
KAFKA_CLIENT_ID=app-namespace
KAFKA_CONSUMER_GROUP=app-namespace-consumers

# Idempotency-Key 캐시 보관 시간(초). 기본 24시간
IDEMPOTENCY_TTL_SECONDS=86400

# 좌석 임시 Hold TTL(초). 기본 5분
SEAT_HOLD_TTL_SECONDS=300
